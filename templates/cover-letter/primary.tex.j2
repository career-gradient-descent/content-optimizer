%-------------------------
% Cover Letter in LaTeX
% Matching letterhead with the resume template (primary)
%------------------------

\documentclass[letterpaper,11pt]{article}

\usepackage[empty]{fullpage}
\usepackage[usenames,dvipsnames]{xcolor}
\usepackage[colorlinks=true]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{geometry}
\input{glyphtounicode}

% Link colour: matches the resume template.
\definecolor{linkblue}{RGB}{0,80,155}
\hypersetup{
    allcolors=linkblue,
    pdftitle={<<name|escape_latex>> Cover Letter},
    pdfauthor={<<name|escape_latex>>},
    pdflang={en-US},
    pdfdisplaydoctitle=true
}

\geometry{letterpaper, left=0.85in, right=0.85in, top=0.8in, bottom=0.8in}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\parindent}{0pt}
\setlength{\parskip}{9pt}

% Machine-readable text layer for ATS parsing.
\pdfgentounicode=1

\begin{document}

%----------LETTERHEAD----------
\begin{center}
    \textbf{\Huge \scshape <<name|escape_latex>>} \\ \vspace{1pt}
    <@ if links and links|length > 0 @>\footnotesize <@ for link in links @><@ if not loop.first @> $|$ <@ endif @>\href{<<link.url>>}{<<link.display|escape_latex>>}<@ endfor @><@ endif @>
\end{center}
\vspace{2pt}
{\color{black!60}\hrule height 0.5pt}
\vspace{12pt}

%----------DATE (OPTIONAL)----------
<@ if date @>
<<date|escape_latex>>

<@ endif @>
%----------RECIPIENT (OPTIONAL)----------
<@ if recipient_name or recipient_title @>
\textbf{<@ if recipient_name @><<recipient_name|escape_latex>><@ endif @><@ if recipient_title @><@ if recipient_name @>, <@ endif @><<recipient_title|escape_latex>><@ endif @>}\\
<@ endif @>
<@ if company @>
<<company|escape_latex>>

<@ endif @>
%----------SUBJECT (OPTIONAL)----------
<@ if subject @>
\textbf{Re: <<subject|escape_latex>>}

<@ endif @>
%----------BODY----------
<<body|escape_latex>>

<@ if closing @>
\vspace{4pt}

<<closing|escape_latex>>
<@ endif @>

\end{document}
